_gold.qss\n./ui/styles/theme_solarized_dark.qss\n./ui/styles/theme_solarized_light.qss\n./ui/ui\n./ui/ui/chat_view.ui\n./ui/ui/composer.ui\n./ui/ui/main_window.ui\n./ui/ui/sidebar.ui\n./ui/widgets\n./ui/widgets/__init__.py\n./ui/widgets/__pycache__\n./ui/widgets/auto_resize_text_edit.py\n./ui/widgets/chat_message.py\n./ui/widgets/chat_view.py\n./ui/widgets/composer.py\n./ui/widgets/conversation_item.py\n./ui/widgets/glass_button.py\n./ui/widgets/preferences_dialog.py\n./ui/widgets/sidebar.py\n./ui/widgets/theme_manager.py\n./ui/widgets/typing_indicator.py\n./ui/widgets/ui_loader.py\n./utilities\n./utilities/__pycache__\n./utilities/__pycache__/utilities.cpython-314.pyc\n./utilities/utilities.py\n./node_modules\n./node_modules/@types\n./node_modules/@types/node\n./node_modules/https\n./node_modules/https/package.json\n./node_modules/image-size\n./node_modules/image-size/LICENSE\n./node_modules/image-size/dist\n./node_modules/image-size/bin\n./node_modules/image-size/package.json\n./node_modules/image-size/Readme.md\n./node_modules/jszip\n./node_modules/jszip/lib\n./node_modules/jszip/deps.js\n./node_modules/jszip/vendor\n./node_modules/jszip/dist\n./node_modules/jszip/package.json\n./node_modules/jszip/tsconfig.json\n./node_modules/jszip/LICENSE.markdown\n./node_modules/jszip/README.markdown\n./node_modules/jszip/CHANGES.md\n./node_modules/jszip/sponsors.md\n./node_modules/jszip/graph.svg\n./node_modules/jszip/index.d.ts\n./node_modules/undici-types\n./node_modules/undici-types/LICENSE\n./node_modules/undici-types/package.json\n./node_modules/undici-types/README.md\n./node_modules/undici-types/agent.d.ts\n./node_modules/undici-types/api.d.ts\n./node_modules/undici-types/balanced-pool.d.ts\n./node_modules/undici-types/cache.d.ts\n./node_modules/undici-types/client.d.ts\n./node_modules/undici-types/connector.d.ts\n./node_modules/undici-types/content-type.d.ts\n./node_modules/undici-types/cookies.d.ts\n./node_modules/undici-types/diagnostics-channel.d.ts\n./node_modules/undici-types/dispatcher.d.ts\n./node_modules/undici-types/env-http-proxy-agent.d.ts\n./node_modules/undici-types/errors.d.ts\n./node_modules/undici-types/eventsource.d.ts\n./node_modules/undici-types/fetch.d.ts\n./node_modules/undici-types/file.d.ts\n./node_modules/undici-types/filereader.d.ts\n./node_modules/undici-types/formdata.d.ts\n./node_modules/undici-types/global-dispatcher.d.ts\n./node_modules/undici-types/global-origin.d.ts\n./node_modules/undici-types/handlers.d.ts\n./node_modules/undici-types/header.d.ts\n./node_modules/undici-types/index.d.ts\n./node_modules/undici-types/interceptors.d.ts\n./node_modules/undici-types/mock-agent.d.ts\n./node_modules/undici-types/mock-client.d.ts\n./node_modules/undici-types/mock-errors.d.ts\n./node_modules/undici-types/mock-interceptor.d.ts\n./node_modules/undici-types/mock-pool.d.ts\n./node_modules/undici-types/patch.d.ts\n./node_modules/undici-types/pool-stats.d.ts\n./node_modules/undici-types/pool.d.ts\n./node_modules/undici-types/proxy-agent.d.ts\n./node_modules/undici-types/readable.d.ts\n./node_modules/undici-types/retry-agent.d.ts\n./node_modules/undici-types/retry-handler.d.ts\n./node_modules/undici-types/util.d.ts\n./node_modules/undici-types/webidl.d.ts\n./node_modules/undici-types/websocket.d.ts\n./node_modules/queue\n./node_modules/queue/LICENSE\n./node_modules/queue/index.js\n./node_modules/queue/package.json\n./node_modules/queue/readme.md\n./node_modules/queue/index.d.ts\n./node_modules/pako\n./node_modules/pako/LICENSE\n./node_modules/pako/lib\n./node_modules/pako/index.js\n./node_modules/pako/dist\n./node_modules/pako/package.json\n./node_modules/pako/CHANGELOG.md\n./node_modules/pako/README.md\n./node_modules/lie\n./node_modules/lie/package.json\n./node_modules/lie/license.md\n./node_modules/lie/lie.d.ts\n./node_modules/lie/polyfill.js\n./node_modules/lie/README.md\n./node_modules/lie/dist\n./node_modules/lie/lib\n./node_modules/readable-stream\n./node_modules/readable-stream/LICENSE\n./node_modules/re