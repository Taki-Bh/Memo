/* =========================================================================
   Memo — Thug Life & Erotic Barber Hood Theme
   ------------------------------------------------------------------------- 
   Palette:
     Background      #120A0F
     Surface         #21121C
     Glass           rgba(255,105,180,0.08)
     Border          rgba(255,20,147,0.2)
     Primary Text    #FFD700
     Secondary Text  #FF69B4
     Accent          #FF1493
     Accent 2        #FF4500
   ========================================================================= */

* {
    font-family: "Cascadia Mono", "Consolas", "Courier New", monospace;
    outline: none;
}

QMainWindow, #centralwidget {
    background-color: #120A0F;
}

QWidget {
    color: #FFD700;
    background-color: transparent;
}

QToolTip {
    background-color: #26111D;
    color: #FFD700;
    border: 1px solid rgba(255,20,147,0.3);
    border-radius: 6px;
    padding: 6px 10px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 0 4px 0;
}
QScrollBar::handle:vertical {
    background: rgba(255,105,180,0.2);
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255,105,180,0.4);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal { height: 0px; }

QSplitter::handle {
    background-color: rgba(255,20,147,0.15);
}

/* Sidebar */
#Sidebar {
    background-color: rgba(33,18,28,0.85);
    border-right: 1px solid rgba(255,20,147,0.2);
}

#brandGlyph {
    color: #FF1493;
    font-size: 18px;
}
#brandLabel {
    color: #FFD700;
    font-size: 16px;

    letter-spacing: 0.5px;
}

#newConversationButton {
    background-color: rgba(255,20,147,0.15);
    border: 1px solid rgba(255,20,147,0.4);
    border-radius: 12px;
    padding: 8px 12px;

    text-align: left;
    color: #FFD700;
}
#newConversationButton:hover {
    background-color: rgba(255,20,147,0.25);
    border: 1px solid rgba(255,20,147,0.7);
}

#conversationSearch {
    background-color: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,20,147,0.2);
    border-radius: 10px;
    padding: 6px 10px;
    color: #FFD700;
    selection-background-color: #FF1493;
}
#conversationSearch:focus {
    border: 1px solid rgba(255,20,147,0.8);
}

#conversationGroupLabel {
    color: #FF69B4;
    font-size: 10px;

    letter-spacing: 1px;
    padding: 10px 6px 4px 6px;
}

#conversationItem {
    border-radius: 10px;
    background-color: transparent;
}
#conversationItem:hover {
    background-color: rgba(255,20,147,0.08);
}
#conversationItem[selected="true"] {
    background-color: rgba(255,20,147,0.2);
    border: 1px solid rgba(255,20,147,0.5);
}
#conversationTitle {
    color: #FFD700;
    font-size: 13px;
    background: transparent;
}
#conversationIcon {
    font-size: 13px;
    background: transparent;
}

#utilitiesSeparator, #headerSeparator {
    background-color: rgba(255,20,147,0.2);
    max-height: 1px;
    border: none;
}

#settingsButton, #preferencesButton, #attachmentsButton,
#toolsUtilityButton, #helpButton {
    text-align: left;
    padding: 6px 10px;
    border-radius: 8px;
    background-color: transparent;
    color: #FF69B4;
    font-size: 13px;
    border: 1px solid transparent;
}
#settingsButton:hover, #preferencesButton:hover, #attachmentsButton:hover,
#toolsUtilityButton:hover, #helpButton:hover {
    background-color: rgba(255,20,147,0.1);
    color: #FFD700;
}

#profileWidget {
    border-top: 1px solid rgba(255,20,147,0.2);
}
#profileAvatar {
    background-color: rgba(255,20,147,0.2);
    border-radius: 16px;
    font-size: 14px;
}
#profileName {
    color: #FFD700;
    font-size: 13px;

}
#profilePlan {
    color: #FF69B4;
    font-size: 11px;
}

/* Chat view */
#ChatView {
    background-color: #120A0F;
}
#headerWidget {
    background-color: rgba(33,18,28,0.7);
}
#assistantNameLabel {
    font-size: 14px;

    color: #FFD700;
}
#statusDot {
    color: #FF1493;
    font-size: 9px;
}
#statusLabel {
    color: #FF69B4;
    font-size: 12px;
}
#modelSelectorCombo {
    background-color: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,20,147,0.3);
    border-radius: 8px;
    padding: 4px 10px;
    color: #FFD700;
    font-size: 12px;
}
#conversationActionsButton {
    background-color: transparent;
    border-radius: 8px;
    color: #FF69B4;
    font-size: 16px;
}
#conversationActionsButton:hover {
    background-color: rgba(255,20,147,0.1);
    color: #FFD700;
}

#messageScrollArea, #messagesContainer {
    background-color: transparent;
}

#emptyStateOrb {
    font-size: 40px;
    color: #FF1493;
    qproperty-alignment: AlignCenter;
}
#emptyStateHeading {
    font-size: 20px;

    color: #FFD700;
    margin-top: 8px;
    qproperty-alignment: AlignCenter;
}
#suggestionCard {
    background-color: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,20,147,0.2);
    border-radius: 12px;
    padding: 10px 16px;
    color: #FFD700;
    font-size: 13px;
}
#suggestionCard:hover {
    background-color: rgba(255,20,147,0.1);
    border: 1px solid rgba(255,20,147,0.5);
}

/* Message bubbles */
#messageBubble[role="user"] {
    background-color: rgba(255,20,147,0.1);
    border: 1px solid rgba(255,20,147,0.25);
    border-radius: 16px;
}
#messageBubble[role="ai"] {
    background-color: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,20,147,0.15);
    border-radius: 16px;
}
#aiAvatar {
    color: #FF1493;
    font-size: 13px;
}
#messageAuthor {
    color: #FF69B4;
    font-size: 12px;

}
#messageTimestamp {
    color: #8B3A62;
    font-size: 11px;
}
#messageBody {
    background: transparent;
    border: none;
    color: #FFF8DC;
    font-size: 13.5px;
}
#messageActionButton {
    background-color: rgba(255,20,147,0.1);
    border: 1px solid rgba(255,20,147,0.2);
    border-radius: 6px;
    padding: 3px 8px;
    color: #FF69B4;
    font-size: 11px;
}
#messageActionButton:hover {
    background-color: rgba(255,20,147,0.2);
    color: #FFD700;
}

/* Composer */
#composerCard {
    background-color: rgba(33,18,28,0.8);
    border: 1px solid rgba(255,20,147,0.3);
    border-radius: 20px;
}
#composerCard:focus-within {
    border: 1px solid rgba(255,20,147,0.8);
}
#messageInput {
    background: transparent;
    border: none;
    color: #FFD700;
    font-size: 14px;
    padding: 6px 4px;
    selection-background-color: #FF1493;
}
#charCountLabel {
    color: #8B3A62;
    font-size: 10px;
}
#attachmentButton, #toolsButton {
    background-color: transparent;
    border: none;
    border-radius: 18px;
    color: #FF69B4;
    font-size: 15px;
}
#attachmentButton:hover, #toolsButton:hover {
    background-color: rgba(255,20,147,0.15);
    color: #FFD700;
}
#sendButton {
    background-color: rgba(255,255,255,0.05);
    border: none;
    border-radius: 18px;
    color: #8B3A62;
    font-size: 15px;
}
#sendButton[active="true"] {
    background-color: #FF1493;
    color: #FFFFFF;

}
#sendButton[active="true"]:hover {
    background-color: #FF69B4;
}

/* Preferences dialog */
#PreferencesDialog {
    background-color: #120A0F;
}
#preferencesTitle {
    color: #FFD700;
    font-size: 16px;

}
#preferencesSectionLabel {
    color: #FF69B4;
    font-size: 10px;

    letter-spacing: 1px;
}
#themeOption {
    border-radius: 12px;
    border: 1px solid rgba(255,20,147,0.2);
    background-color: rgba(255,255,255,0.03);
    padding: 10px 12px;
    text-align: left;
    color: #FFD700;
}
#themeOption:hover {
    background-color: rgba(255,20,147,0.1);
}
#themeOption[active="true"] {
    border: 1px solid rgba(255,20,147,0.8);
    background-color: rgba(255,20,147,0.25);
    color: #FFD700;

}
#themeSwatch {
    border-radius: 8px;
    border: 1px solid rgba(255,20,147,0.4);
}
#preferencesCloseButton {
    background-color: rgba(255,20,147,0.2);
    border: none;
    border-radius: 10px;
    padding: 8px 16px;
    color: #FFD700;

}
#preferencesCloseButton:hover {
    background-color: rgba(255,20,147,0.4);
}
