/* =========================================================================
   Memo — AI Assistant theme (After Dark / Vampiric Goth Synthwave)
   -------------------------------------------------------------------------
   Centralized QSS. Every custom widget in this project is styled from
   here via objectName / dynamic properties.

   Palette:
     Background      #050505
     Surface         #0d0808
     Glass           rgba(255,42,42,0.05)
     Border          rgba(255,42,42,0.15)
     Primary Text    #e5e5e5
     Secondary Text  #998888
     Accent          #ff2a2a
     Accent 2        #8b0000
   ========================================================================= */

* {
    font-family: "Segoe UI", "Inter", "SF Pro Text", sans-serif;
    outline: none;
}

QMainWindow, #centralwidget {
    background-color: #050505;
}

QWidget {
    color: #e5e5e5;
    background-color: transparent;
}

QToolTip {
    background-color: #120303;
    color: #e5e5e5;
    border: 1px solid rgba(255,42,42,0.20);
    border-radius: 6px;
    padding: 6px 10px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 0 4px 0;
}
QScrollBar::handle:vertical {
    background: rgba(139,0,0,0.4);
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255,42,42,0.6);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal { height: 0px; }

QSplitter::handle {
    background-color: rgba(255,42,42,0.1);
}

/* ---------------------------------------------------------------------
   Sidebar — translucent glass panel
   --------------------------------------------------------------------- */
#Sidebar {
    background-color: rgba(13, 8, 8, 0.85);
    border-right: 1px solid rgba(255,42,42,0.12);
}

#brandGlyph {
    color: #ff2a2a;
    font-size: 18px;
}
#brandLabel {
    color: #e5e5e5;
    font-size: 16px;

    letter-spacing: 0.3px;
}

#newConversationButton {
    background-color: rgba(255, 42, 42, 0.12);
    border: 1px solid rgba(255, 42, 42, 0.35);
    border-radius: 12px;
    padding: 8px 12px;

    text-align: left;
    color: #ff9999;
}
#newConversationButton:hover {
    background-color: rgba(255, 42, 42, 0.20);
    border: 1px solid rgba(255, 42, 42, 0.55);
}
#newConversationButton:pressed {
    background-color: rgba(255, 42, 42, 0.28);
}

#conversationSearch {
    background-color: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,42,42,0.15);
    border-radius: 10px;
    padding: 6px 10px;
    color: #e5e5e5;
    selection-background-color: #ff2a2a;
}
#conversationSearch:focus {
    border: 1px solid rgba(255, 42, 42, 0.55);
    background-color: rgba(255,255,255,0.05);
}

#conversationGroupLabel {
    color: #8b0000;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 10px 6px 4px 6px;
}

#conversationItem {
    border-radius: 10px;
    background-color: transparent;
}
#conversationItem:hover {
    background-color: rgba(255,42,42,0.06);
}
#conversationItem[selected="true"] {
    background-color: rgba(255, 42, 42, 0.18);
    border: 1px solid rgba(255, 42, 42, 0.40);
}
#conversationTitle {
    color: #e5e5e5;
    font-size: 13px;
    background: transparent;
}
#conversationIcon {
    font-size: 13px;
    background: transparent;
}

#utilitiesSeparator, #headerSeparator {
    background-color: rgba(255,42,42,0.15);
    max-height: 1px;
    border: none;
}

#settingsButton, #preferencesButton, #attachmentsButton,
#toolsUtilityButton, #helpButton {
    text-align: left;
    padding: 6px 10px;
    border-radius: 8px;
    background-color: transparent;
    color: #b38888;
    font-size: 13px;
    border: 1px solid transparent;
}
#settingsButton:hover, #preferencesButton:hover, #attachmentsButton:hover,
#toolsUtilityButton:hover, #helpButton:hover {
    background-color: rgba(255,42,42,0.06);
    color: #e5e5e5;
}

#profileWidget {
    border-top: 1px solid rgba(255,42,42,0.12);
}
#profileAvatar {
    background-color: rgba(139, 0, 0, 0.25);
    border-radius: 16px;
    font-size: 14px;
}
#profileName {
    color: #e5e5e5;
    font-size: 13px;

}
#profilePlan {
    color: #8b0000;
    font-size: 11px;
}

/* ---------------------------------------------------------------------
   Chat view — header, message list, empty state
   --------------------------------------------------------------------- */
#ChatView {
    background-color: #050505;
}

#headerWidget {
    background-color: rgba(13, 8, 8, 0.75);
}
#assistantNameLabel {
    font-size: 14px;

    color: #e5e5e5;
}
#statusDot {
    color: #ff2a2a;
    font-size: 9px;
}
#statusLabel {
    color: #998888;
    font-size: 12px;
}
#modelSelectorCombo {
    background-color: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,42,42,0.15);
    border-radius: 8px;
    padding: 4px 10px;
    color: #e5e5e5;
    font-size: 12px;
}
#modelSelectorCombo::drop-down {
    border: none;
    width: 18px;
}
#conversationActionsButton {
    background-color: transparent;
    border-radius: 8px;
    color: #998888;
    font-size: 16px;
}
#conversationActionsButton:hover {
    background-color: rgba(255,42,42,0.06);
    color: #e5e5e5;
}

#messageScrollArea, #messagesContainer {
    background-color: transparent;
}

#emptyStateOrb {
    font-size: 40px;
    color: #ff2a2a;
    qproperty-alignment: AlignCenter;
}
#emptyStateHeading {
    font-size: 20px;

    color: #e5e5e5;
    margin-top: 8px;
    qproperty-alignment: AlignCenter;
}
#suggestionCard {
    background-color: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,42,42,0.15);
    border-radius: 12px;
    padding: 10px 16px;
    color: #d1c7c7;
    font-size: 13px;
}
#suggestionCard:hover {
    background-color: rgba(255,42,42,0.06);
    border: 1px solid rgba(255, 42, 42, 0.40);
    color: #e5e5e5;
}

/* Message bubbles */
#messageBubble[role="user"] {
    background-color: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,42,42,0.15);
    border-radius: 16px;
}
#messageBubble[role="ai"] {
    background-color: rgba(18,3,3,0.30);
    border: 1px solid rgba(255,42,42,0.10);
    border-radius: 16px;
}
#aiAvatar {
    color: #ff2a2a;
    font-size: 13px;
}
#messageAuthor {
    color: #b38888;
    font-size: 12px;

}
#messageTimestamp {
    color: #553333;
    font-size: 11px;
}
#messageBody {
    background: transparent;
    border: none;
    color: #e5e5e5;
    font-size: 13.5px;
}
#messageActionButton {
    background-color: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,42,42,0.12);
    border-radius: 6px;
    padding: 3px 8px;
    color: #998888;
    font-size: 11px;
}
#messageActionButton:hover {
    background-color: rgba(255,42,42,0.08);
    color: #e5e5e5;
}

#typingIndicator #typingText {
    color: #8b0000;
    font-size: 12px;
}
#typingDot {
    color: #8b0000;
    font-size: 16px;
}
#typingDot[active="true"] {
    color: #ff2a2a;
}

/* ---------------------------------------------------------------------
   Composer — floating glass capsule
   --------------------------------------------------------------------- */
#composerCard {
    background-color: rgba(18, 3, 3, 0.60);
    border: 1px solid rgba(255, 42, 42, 0.20);
    border-radius: 20px;
}
#composerCard:focus-within {
    border: 1px solid rgba(255, 42, 42, 0.55);
}

#messageInput {
    background: transparent;
    border: none;
    color: #e5e5e5;
    font-size: 14px;
    padding: 6px 4px;
    selection-background-color: #ff2a2a;
}

#charCountLabel {
    color: #553333;
    font-size: 10px;
}

#attachmentButton, #toolsButton {
    background-color: transparent;
    border: none;
    border-radius: 18px;
    color: #998888;
    font-size: 15px;
}
#attachmentButton:hover, #toolsButton:hover {
    background-color: rgba(255,42,42,0.08);
    color: #e5e5e5;
}

#sendButton {
    background-color: rgba(255,255,255,0.03);
    border: none;
    border-radius: 18px;
    color: #553333;
    font-size: 15px;
}
#sendButton[active="true"] {
    background-color: #ff2a2a;
    color: #050505;
    font-weight: 700;
}
#sendButton[active="true"]:hover {
    background-color: #ff5555;
}
#sendButton:disabled {
    color: #2b1111;
    background-color: rgba(255,255,255,0.01);
}

/* ---------------------------------------------------------------------
   Preferences dialog
   --------------------------------------------------------------------- */
#PreferencesDialog {
    background-color: #050505;
}
#preferencesTitle {
    color: #e5e5e5;
    font-size: 16px;
    font-weight: 700;
}
#preferencesSectionLabel {
    color: #8b0000;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}
#themeOption {
    border-radius: 12px;
    border: 1px solid rgba(255,42,42,0.15);
    background-color: rgba(18,3,3,0.30);
    padding: 10px 12px;
    text-align: left;
    color: #d1c7c7;
}
#themeOption:hover {
    background-color: rgba(255,42,42,0.08);
}
#themeOption[active="true"] {
    border: 1px solid rgba(255, 42, 42, 0.60);
    background-color: rgba(255, 42, 42, 0.18);
    color: #e5e5e5;

}
#themeSwatch {
    border-radius: 8px;
    border: 1px solid rgba(255,42,42,0.25);
}
#preferencesCloseButton {
    background-color: rgba(18,3,3,0.60);
    border: 1px solid rgba(255,42,42,0.20);
    border-radius: 10px;
    padding: 8px 16px;
    color: #e5e5e5;

}
#preferencesCloseButton:hover {
    background-color: rgba(255,42,42,0.15);
}